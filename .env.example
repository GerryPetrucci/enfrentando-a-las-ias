# Copia este archivo a .env y pon tu llave real.
# .env esta en .gitignore: nunca subas tu llave al repositorio.

# Una sola llave para todos los modelos: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-TU_LLAVE_AQUI

# Opcional: tu dominio, aparece en las estadisticas de OpenRouter.
SITIO_URL=https://enfrentandoalasias.com

# Puente local WorldBox. No contiene secretos; proporciona el token por entorno.
WORLDBOX_PUENTE_URL=http://127.0.0.1:47600
WORLDBOX_PUENTE_TOKEN=
WORLDBOX_PRESUPUESTO_USD=0
