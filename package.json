{
  "name": "enfrentando-a-las-ias",
  "version": "0.1.0",
  "description": "Torneos entre modelos de IA: motor de juegos, marcador por categoria y reproductor vertical para video.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "duelo": "node src/correr.js --juego=lobo --partidas=1",
    "marcador": "node src/marcador.js",
    "sitio": "node src/servidor.js",
    "humo": "node src/humo.js",
    "recortar": "node herramientas/recortar-formatos.mjs",
    "test": "node --test",
    "demo": "node src/correr.js --juego=lobo --partidas=1 --destino=pruebas && node src/marcador.js"
  }
}
